{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tap-rater-app-git",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "limits": {
    "cpu_ms": 30000,
    "subrequests": 5000
  },
  "ai": {
    "binding": "REVIEW_AI"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "taprater.com/*",
      "zone_name": "taprater.com"
    },
    {
      "pattern": "www.taprater.com/*",
      "zone_name": "taprater.com"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECOVERY_BACKUPS",
      "bucket_name": "tap-rater-recovery-backups"
    },
    {
      "binding": "PRODUCT_MEDIA_BUCKET",
      "bucket_name": "tap-rater-product-media"
    },
    {
      "binding": "HOSTED_PAGE_SNAPSHOTS",
      "bucket_name": "tap-rater-hosted-page-snapshots"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "tap-rater-public-cache"
    }
  ],
  "ratelimits": [
    {
      "name": "SUPPORT_FORM_RATE_LIMITER",
      "namespace_id": "724004",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "SUPPORT_FORM_DUPLICATE_LIMITER",
      "namespace_id": "724005",
      "simple": {
        "limit": 1,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_FORM_RATE_LIMITER",
      "namespace_id": "724001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_PROOF_RATE_LIMITER",
      "namespace_id": "724006",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_CHECKOUT_RATE_LIMITER",
      "namespace_id": "724002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_EVENT_RATE_LIMITER",
      "namespace_id": "724003",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "GOOGLE_REVIEWS_PUBLISHING_ENABLED": "true",
    "NEXT_PUBLIC_SITE_URL": "https://taprater.com",
    "NEXT_PUBLIC_ACCOUNT_APP_URL": "https://taprater.com",
    "GA4_MEASUREMENT_ID": "G-MVBHN8KW2S",
    "GA4_ENABLED": "true",
    "GA4_MANUAL_EVENTS_CONFIRMED": "true",
    "PRODUCT_MEDIA_PUBLIC_BASE_URL": "",
    "STRIPE_MODE": "live",
    "MARKETING_CHECKOUT_ENABLED": "true",
    "MARKETING_PORTAL_CONFIGURATION_ID": "default",
    "MARKETING_TEST_ENTITLEMENTS": "false",
    "STRIPE_BILLING_PORTAL_CONFIGURED": "true",
    "STRIPE_CUSTOMER_EMAILS_CONFIGURED": "true",
    "ORDER_NOTIFICATION_EMAIL": "orders@taprater.com",
    "SUPPORT_NOTIFICATION_EMAIL": "support@taprater.com",
    "SUPPORT_FROM_EMAIL": "Tap Rater Support <support@taprater.com>",
    "CUSTOMER_SUPPORT_EMAIL": "support@taprater.com",
    "ORDER_FROM_EMAIL": "Tap Rater Orders <orders@taprater.com>",
    "ORDER_REPLY_TO_EMAIL": "orders@taprater.com",
    "TAP_RATER_ENABLE_PRODUCTION_HOSTED_PAGES": "true",
    "TAP_RATER_ENABLE_HOSTED_PURCHASING": "true",
    "PUBLIC_DATA_CACHE_ENABLED": "true"
  },
  "d1_databases": [
    {
      "database_id": "4fe4aac0-e0a7-4ffd-a34f-cc4c89b4f1cd",
      "database_name": "tap-rater-public-cache-tags",
      "binding": "NEXT_TAG_CACHE_D1"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tap-rater-app-git"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "DOQueueHandler",
        "name": "NEXT_CACHE_DO_QUEUE"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": [
        "DOQueueHandler"
      ],
      "tag": "public-cache-v1"
    }
  ]
}
