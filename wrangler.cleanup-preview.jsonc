{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tap-rater-cleanup-preview",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "GOOGLE_REVIEWS_PUBLISHING_ENABLED": "false",
    "MARKETING_CHECKOUT_ENABLED": "false",
    "TAP_RATER_ENABLE_PRODUCTION_HOSTED_PAGES": "false",
    "TAP_RATER_ENABLE_HOSTED_PURCHASING": "false",
    "GA4_ENABLED": "false"
  }
}
