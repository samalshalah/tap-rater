{
  "name": "tap-rater",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/backend"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run images:generate && next build --webpack",
    "cf:build": "npm run images:generate && opennextjs-cloudflare build",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "upload": "npm run cf:build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts --include-runtime=false --strict-vars=false && node scripts/normalize-cloudflare-env-types.mjs",
    "hosted-pages:typegen": "wrangler types --config workers/hosted-pages/wrangler.jsonc workers/hosted-pages/worker-configuration.d.ts",
    "hosted-pages:check": "wrangler deploy --dry-run --config workers/hosted-pages/wrangler.jsonc",
    "backend:dev": "npm --workspace @tap-rater/backend run dev",
    "backend:build": "npm --workspace @tap-rater/backend run build",
    "backend:start": "npm --workspace @tap-rater/backend run start",
    "backend:db-check": "npm --workspace @tap-rater/backend run db-check",
    "backend:email-test": "npm --workspace @tap-rater/backend run email-test",
    "start": "next start",
    "smoke": "node scripts/smoke.mjs",
    "sync:products": "node scripts/sync-products.mjs",
    "milestone7:qa:check-env": "node scripts/milestone7-qa-runtime.mjs --check",
    "milestone7:qa:dev": "node scripts/milestone7-qa-runtime.mjs --dev",
    "check:platform-schema": "node scripts/check-platform-schema.mjs",
    "check:recovery-readiness": "node scripts/check-recovery-readiness.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "images:generate": "node scripts/generate-image-variants.mjs",
    "images:check": "node scripts/generate-image-variants.mjs --check",
    "test": "vitest run",
    "predev": "node scripts/prepare-logo-converters.mjs",
    "prebuild": "node scripts/prepare-logo-converters.mjs"
  },
  "dependencies": {
    "@imagemagick/magick-wasm": "0.0.45",
    "@jspawn/ghostscript-wasm": "0.0.2",
    "@neondatabase/serverless": "^1.1.0",
    "@stripe/react-stripe-js": "^6.9.0",
    "@stripe/stripe-js": "^9.15.0",
    "@supabase/supabase-js": "^2.110.2",
    "heic-to": "1.6.7",
    "lucide-react": "^0.468.0",
    "next": "^16.4.5",
    "opentype.js": "1.3.4",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.17.2",
    "stripe": "^22.6.1",
    "three": "0.178.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@opennextjs/cloudflare": "^1.20.16",
    "@types/node": "^22.10.0",
    "@types/opentype.js": "1.3.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "jsqr": "1.4.0",
    "miniflare": "^4.20260730.0",
    "postcss": "^8.4.49",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  }
}
