{
  "name": "tap-rater",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/backend"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "hosted-pages:typegen": "wrangler types --config workers/hosted-pages/wrangler.jsonc workers/hosted-pages/worker-configuration.d.ts",
    "hosted-pages:check": "wrangler deploy --dry-run --config workers/hosted-pages/wrangler.jsonc",
    "backend:dev": "npm --workspace @tap-rater/backend run dev",
    "backend:build": "npm --workspace @tap-rater/backend run build",
    "backend:start": "npm --workspace @tap-rater/backend run start",
    "backend:db-check": "npm --workspace @tap-rater/backend run db-check",
    "backend:email-test": "npm --workspace @tap-rater/backend run email-test",
    "start": "next start",
    "smoke": "node scripts/smoke.mjs",
    "sync:products": "node scripts/sync-products.mjs",
    "milestone7:qa:check-env": "node scripts/milestone7-qa-runtime.mjs --check",
    "milestone7:qa:dev": "node scripts/milestone7-qa-runtime.mjs --dev",
    "check:platform-schema": "node scripts/check-platform-schema.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@stripe/react-stripe-js": "^6.9.0",
    "@stripe/stripe-js": "^9.15.0",
    "@supabase/supabase-js": "^2.110.2",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.17.2",
    "stripe": "^22.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "wrangler": "4.129.0"
  }
}
