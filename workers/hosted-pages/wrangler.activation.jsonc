{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tap-rater-hosted-pages",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "taprater.com/p/*",
      "zone_name": "taprater.com"
    }
  ],
  "r2_buckets": [
    {
      "binding": "HOSTED_PAGE_SNAPSHOTS",
      "bucket_name": "tap-rater-hosted-page-snapshots"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "production"
  }
}
